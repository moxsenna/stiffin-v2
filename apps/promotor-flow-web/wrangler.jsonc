{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "stiffin-promotor-flow",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "stiffin-promotor-flow"
    }
  ],
  "vars": {
    "NEXT_PRIVATE_MINIMAL_MODE": "1"
  },
  "env": {
    "staging": {
      "name": "promotor-flow-staging",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "promotor-flow-staging"
        }
      ],
      "vars": {
        "NEXT_PRIVATE_MINIMAL_MODE": "1",
        "NEXT_PUBLIC_API_MODE": "http",
        "NEXT_PUBLIC_API_URL": "https://stiffin-promotor-api-staging.moxsenna.workers.dev"
      }
    }
  }
}
