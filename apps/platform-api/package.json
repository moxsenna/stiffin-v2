{
  "name": "@promotor/platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 src/__tests__/integration/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx tooling/migrate.ts",
    "b1:live-acceptance": "tsx tooling/b1-live-acceptance.ts",
    "b2:live-acceptance": "tsx tooling/b2-live-acceptance.ts",
    "b6:live-acceptance": "tsx tooling/b6-live-acceptance.ts",
    "b6.1:live-acceptance": "tsx tooling/b6.1-live-acceptance.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:cf": "wrangler deploy"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.28",
    "@better-auth/utils": "0.4.2",
    "@promotor/contracts": "workspace:*",
    "@promotor/platform-core": "workspace:*",
    "better-auth": "1.6.28",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.2",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "0.30.6",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3",
    "wrangler": "^3.114.0"
  }
}
