{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stiffin-promotor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  // Cron dinonaktifkan sementara: akun CF Free limit 5 cron trigger/account.
  // Sweep Learner Macet dijalankan manual via endpoint admin sampai upgrade Paid.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "1cb577ffc7524f4591a89206bb19d535"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "https://stiffin-promotor-api.moxsenna.workers.dev",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://stiffin-promotor-class.moxsenna.workers.dev,https://stiffin-promotor-flow.moxsenna.workers.dev,https://class.ralivo.biz.id,https://flow.ralivo.biz.id",
    "INACTIVITY_SWEEP_DAYS": "7",
    "LEARNER_OTP_CHANNEL": "log",
    "EMAIL_MODE": "mailketing",
    "EMAIL_FROM": "noreply@ralivo.biz.id",
    "EMAIL_FROM_NAME": "Ralivo"
  },
  "env": {
    "staging": {
      "name": "stiffin-promotor-api-staging",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "ea7e56b0c0424b33a8c8156b8bb923bc"
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        "BETTER_AUTH_URL": "https://stiffin-promotor-api-staging.moxsenna.workers.dev",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://promotor-class-staging.moxsenna.workers.dev,https://promotor-flow-staging.moxsenna.workers.dev",
        "INACTIVITY_SWEEP_DAYS": "7",
        "EMAIL_MODE": "mailketing",
        "EMAIL_FROM": "noreply@ralivo.biz.id",
        "EMAIL_FROM_NAME": "Ralivo"
      }
    }
  }
}
