{
  "name": "promotor-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:class": "pnpm --filter @promotor/promotor-class-web dev",
    "dev:api": "pnpm --filter @promotor/platform-api dev",
    "build:class": "pnpm --filter @promotor/promotor-class-web build",
    "build:flow": "pnpm --filter @promotor/promotor-flow-web build",
    "build:api": "pnpm --filter @promotor/platform-api build",
    "preview:class:cf": "pnpm --filter @promotor/promotor-class-web preview:cf",
    "preview:flow:cf": "pnpm --filter @promotor/promotor-flow-web preview:cf",
    "deploy:class:cf": "pnpm --filter @promotor/promotor-class-web deploy:cf",
    "deploy:flow:cf": "pnpm --filter @promotor/promotor-flow-web deploy:cf",
    "rehearsal:b6": "pnpm --filter @promotor/platform-api b6:live-acceptance",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @promotor/platform-api test:integration"
  },
  "overrides": {
    "@aws-sdk/xml-builder": "3.972.33",
    "@aws-sdk/signature-v4-multi-region": "3.996.38"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "next": "14.2.35",
    "sharp": "^0.35.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "styled-jsx": "5.1.1"
  }
}
